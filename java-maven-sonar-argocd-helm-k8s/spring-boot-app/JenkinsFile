pipeline {
    agent any
    stages {
        stage('Prepare: Clean Workspace') {
            steps {
                deleteDir() // Fresh start every time
            }
        }

        stage('Clone Repository') {
            steps {
                sh 'git clone https://github.com/yayayekinni1-alt/Jenkins-Zero-To-Hero.git .'
            }
        }

        stage('Build & Package with Maven') {
            agent {
                docker {
                    image 'abhishekf5/maven-abhishek-docker-agent:v1'
                    args '-u root -v /var/run/docker.sock:/var/run/docker.sock'
                    alwaysPull false // Optional: speeds up repeated runs
                }
            }
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Static Code Analysis — SonarQube') {
            options { skipDefaultCheckout true }
            environment {
                // ⚠️ Replace with YOUR working SonarQube URL
                SONAR_URL = "http://54.204.119.41:9000"
            }
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                    withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                        sh 'mvn sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
                    }
                }
            }
        }

        stage('Build & Push Docker Image') {
            environment {
                DOCKER_IMAGE = "yayayekinni1/ultimate-cicd:${BUILD_NUMBER}"
            }
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                    script {
                        sh 'docker build -t ${DOCKER_IMAGE} .'
                        docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
                            sh 'docker push ${DOCKER_IMAGE}'
                        }
                    }
                }
            }
        }

        stage('Update Deployment Manifest') {
            environment {
                GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
                GIT_USER_NAME = "yayayekinni1-alt"
            }
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "yayayekinni1-alt@users.noreply.github.com"
                        git config user.name "${GIT_USER_NAME}"
                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                        git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                        git commit -m "Update deployment image to version ${BUILD_NUMBER}" || echo "No changes to commit"
                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                    '''
                }
            }
        }
    }
}
