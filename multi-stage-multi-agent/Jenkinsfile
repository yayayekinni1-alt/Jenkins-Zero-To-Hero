pipeline {
  agent none
  stages {
    stage('Prepare') {
      agent { docker { image 'node:jod-alpine3.24' } }
      steps { checkout scm; sh 'node --version'; stash includes: '**', name: 'all' }
    }
    stage('Build') {
      agent { docker { image 'node:jod-alpine3.24' } }
      steps sh 'mkdir ingress'
    }
    stage('Test') {
      agent { docker { image 'node:jod-alpine3.24' } }
      steps { unstash 'all'; sh 'ls -a' }
    }
    stage('Deploy') {
      agent { docker { image 'docker:latest' } }
      steps { unstash 'out'; sh 'echo yaya' }
    }
  }
}
