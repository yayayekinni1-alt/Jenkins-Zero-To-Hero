pipeline {
  agent none
  stages {
    stage('Prepare') {
      agent { docker { image 'node:22.23-alpine' } }
      }
      steps {
        sh 'mvn --version'
    }
    stage('Build') {
      agent { docker { image 'node:22.23-alpine' } }
      steps { unstash 'all'; sh 'npm run build'; stash includes: 'dist/**', name: 'out' }
    }
    stage('Test') {
      agent { docker { image 'node:22.23-alpine' } }
      steps { unstash 'all'; sh 'npm test' }
    }
    stage('Deploy') {
      agent { docker { image 'docker:latest' } }
      steps { unstash 'out'; sh 'docker build -t app .' }
    }
  }
}
